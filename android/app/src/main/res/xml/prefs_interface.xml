<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <!-- Atlas: open on the map or on the search screen's Directory tab. Not persisted here: StartOn keeps it. -->
  <com.wanderwildwood.chizu.ui.StartOnPreference
    android:key="atlas_start_on"
    android:persistent="false"
    android:title="@string/start_on_title" />
  <SwitchPreferenceCompat
    android:key="@string/pref_show_zoom_buttons"
    android:summary="@string/pref_zoom_summary"
    android:title="@string/pref_zoom_title"
    android:widgetLayout="@layout/preference_switch"
    app:singleLineTitle="false" />
  <ListPreference
    android:key="@string/pref_left_button"
    android:persistent="true"
    android:title="@string/pref_left_button_title"
    app:singleLineTitle="false" />
  <Preference
    android:key="@string/pref_app_locale"
    android:persistent="false"
    android:title="@string/change_app_locale"
    app:icon="@drawable/ic_translate"
    app:singleLineTitle="false" />
  <!-- Atlas: no "Long tap to hide user interface" switch. A held tap opens what is held, or puts a
       pin on a bare point (Framework::OnTapEvent). -->
  <!-- Not stored here: DarkMode keeps the state (and follows Home's switch). -->
  <SwitchPreferenceCompat
    android:key="@string/pref_dark_mode"
    android:persistent="false"
    android:title="@string/settings_dark"
    android:widgetLayout="@layout/preference_switch"
    app:singleLineTitle="false" />

</androidx.preference.PreferenceScreen>
