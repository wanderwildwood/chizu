<?xml version="1.0" encoding="utf-8"?>
<!-- A bottom sheet: paper under a 2dp top edge of ink, square, no shadow (house rule). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/house_ink"/>
    </shape>
  </item>
  <item android:top="@dimen/house_edge">
    <shape android:shape="rectangle">
      <solid android:color="@color/house_paper"/>
    </shape>
  </item>
</layer-list>
