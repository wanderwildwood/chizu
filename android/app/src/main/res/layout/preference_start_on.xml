<?xml version="1.0" encoding="utf-8"?>
<!-- Atlas: Settings, Interface. "Start on": Map or Directory as two choices side by side,
     the same row as Navigation units, with its title above. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@color/house_paper"
  android:orientation="vertical"
  android:paddingTop="@dimen/margin_half"
  android:paddingBottom="@dimen/margin_half">
  <TextView
    android:id="@android:id/title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingBottom="@dimen/margin_half"
    android:textAppearance="?android:attr/textAppearanceListItem" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/margin_half">
    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/start_on_map"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/house_choice"
      android:gravity="center"
      android:maxLines="1"
      android:text="@string/start_on_map"
      android:textColor="@color/house_tab_text"
      android:textSize="16sp"
      android:textStyle="bold" />
    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/start_on_directory"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/house_choice"
      android:gravity="center"
      android:maxLines="1"
      android:text="@string/start_on_directory"
      android:textColor="@color/house_tab_text"
      android:textSize="16sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
