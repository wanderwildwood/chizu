<?xml version="1.0" encoding="utf-8"?>
<!-- Atlas: one row of the Directory place screen: a small label over its value (or the week's hours). -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@null"
  android:orientation="vertical"
  android:paddingStart="@dimen/margin_base"
  android:paddingTop="@dimen/margin_half_plus"
  android:paddingEnd="@dimen/margin_base"
  android:paddingBottom="@dimen/margin_half_plus">
  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/directory_row_label"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:letterSpacing="0.04"
    android:textAllCaps="true"
    android:textColor="@color/house_ink"
    android:textSize="16sp" />
  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/directory_row_value"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_eighth"
    android:textColor="@color/house_ink"
    android:textIsSelectable="false"
    android:textSize="@dimen/text_size_body_1"
    android:textStyle="bold" />
  <TableLayout
    android:id="@+id/directory_row_hours"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_eighth"
    android:shrinkColumns="1"
    android:stretchColumns="1"
    android:visibility="gone" />
</LinearLayout>
