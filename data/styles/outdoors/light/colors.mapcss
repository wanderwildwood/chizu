/*
 * Keep here changes of the base map style files only
 * (see style.mapcss for exact processing order).
 *
 * Atlas: the outdoors map is drawn in the same ink as the main one. CoMaps' own colors for
 * cycleways, footways, railways and road edges are not set here, so those come from
 * default/light/colors.mapcss; only what the main style has no name for stays.
 */

@railway_dark: #333333; /* a little darker than the main style's @railway */
