<?xml version="1.0" encoding="utf-8"?>
<!-- The chosen tab is a stone of ink with a 4dp corner; the others carry no mark (house rule). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_selected="true">
    <inset android:insetTop="12dp" android:insetBottom="12dp" android:insetLeft="4dp" android:insetRight="4dp">
      <shape android:shape="rectangle">
        <solid android:color="@color/house_ink"/>
        <corners android:radius="4dp"/>
      </shape>
    </inset>
  </item>
  <item android:drawable="@android:color/transparent"/>
</selector>
