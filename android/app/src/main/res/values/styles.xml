<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

  <style name="MwmWidget"/>

  <style name="MwmWidget.ProgressWheel"/>

  <style name="MwmWidget.SpeedLimit">
    <item name="speedLimitAlertColor">@android:color/black</item>
    <item name="speedLimitBorderColor">@android:color/black</item>
  </style>

  <style name="MwmWidget.CurrentSpeed">
    <item name="speedLimitBorderColor">@color/black_primary</item>
  </style>

  <style name="MwmWidget.FrameLayout"/>

  <style name="MwmWidget.Downloader"/>

  <style name="MwmWidget.MapButton" parent="Theme.Material3.Dark">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:backgroundTint">?menuBackground</item>
    <item name="elevation">0dp</item>
    <item name="hoveredFocusedTranslationZ">0dp</item>
    <item name="pressedTranslationZ">0dp</item>
    <item name="android:tint">?iconTint</item>
    <item name="fabCustomSize">@dimen/map_button_size</item>
    <item name="maxImageSize">@dimen/map_button_icon_size</item>
    <item name="borderWidth">0dp</item>
  </style>

  <style name="MwmWidget.MapButton.Zoom">
    <item name="maxImageSize">34dp</item>
  </style>

  <style name="MwmWidget.Components.SearchWheel" parent="Widget.MaterialComponents.FloatingActionButton">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:backgroundTint">?menuBackground</item>
    <item name="backgroundTint">?menuBackground</item>
    <item name="elevation">0dp</item>
    <item name="hoveredFocusedTranslationZ">0dp</item>
    <item name="pressedTranslationZ">0dp</item>
    <item name="android:tint">?iconTint</item>
    <item name="tint">?iconTint</item>
    <item name="maxImageSize">@dimen/map_button_icon_size</item>
    <item name="borderWidth">0dp</item>
    <item name="fabCustomSize">38dp</item>
    <item name="ensureMinTouchTargetSize">false</item>
  </style>

  <style name="MwmWidget.MapButton.Bottom">
    <item name="android:maxWidth">@dimen/map_buttons_bottom_max_width</item>
    <item name="android:padding">@dimen/nav_frame_padding</item>
  </style>

  <style name="MwmWidget.MapButton.Square">
    <item name="android:backgroundTint">?menuBackground</item>
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">10dp</item>
  </style>

  <style name="MwmWidget.Button">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">?buttonBackground</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="android:fontFamily">@font/lato_bold</item>
    <item name="android:letterSpacing">0.04</item>
    <item name="backgroundTint">@null</item>
  </style>

  <style name="MwmWidget.Button.Accent">
    <item name="android:background">?accentButtonBackground</item>
    <item name="android:textColor">?accentButtonTextColor</item>
    <item name="backgroundTint">@null</item>
  </style>

  <style name="MwmWidget.Button.StackedButtonsDialog" parent="@style/MwmTheme.M3.AlertDialog.Button">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:lines">2</item>
    <item name="android:gravity">center_vertical|end</item>
  </style>

  <style name="MwmWidget.StackedButtonsDialogTitle" parent="@style/MaterialAlertDialog.Material3.Title.Text">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginBottom">@dimen/margin_dialog_title</item>
    <item name="android:textAppearance">@style/MwmTextAppearance.Body1</item>
  </style>

  <style name="MwmWidget.StackedButtonsDialogMessage" parent="@style/MaterialAlertDialog.Material3.Body.Text">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
  </style>

  <style name="MwmWidget.Button.Primary">
    <item name="android:background">?primaryButtonBackground</item>
    <item name="android:minWidth">@dimen/primary_button_min_width</item>
    <item name="android:minHeight">@dimen/primary_button_min_height</item>
    <item name="android:textColor">?accentButtonTextColor</item>
    <item name="android:textSize">@dimen/text_size_body_3</item>
    <item name="android:paddingStart">@dimen/margin_base</item>
    <item name="android:paddingEnd">@dimen/margin_base</item>
    <item name="textAllCaps">true</item>
    <item name="android:gravity">center</item>
    <item name="backgroundTint">@null</item>
  </style>

  <style name="MwmWidget.ProgressWheel.RoutingPlan">
    <item name="android:layout_width">@dimen/routing_selector_wheel_size</item>
    <item name="android:layout_height">@dimen/routing_selector_wheel_size</item>
    <item name="android:visibility">invisible</item>
    <item name="android:background">?selectableItemBackgroundBorderless</item>
    <item name="centerDrawable">@android:color/transparent</item>
    <item name="wheelProgressColor">?routingButtonHint</item>
    <item name="wheelSecondaryColor">@android:color/transparent</item>
    <item name="wheelThickness">@dimen/margin_eighth</item>
  </style>
  
  <style name="MwmWidget.Floating">
    <item name="android:elevation">0dp</item>
  </style>

  <style name="ShapeAppearanceOverlay.Button.Round" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">50%</item>
  </style>

  <!-- House rule: a top bar is paper with ink on it, flat, with a thin rule beneath. -->
  <style name="MwmWidget.ToolbarStyle" parent="Widget.Material3.Toolbar">
    <item name="android:background">@drawable/house_bar</item>
    <item name="android:elevation">0dp</item>
    <item name="android:displayOptions">homeAsUp|showTitle</item>
    <item name="contentInsetStart">0dp</item>
    <item name="titleTextColor">@color/house_ink</item>
    <item name="subtitleTextColor">@color/house_ink</item>
    <item name="navigationIconTint">@color/house_ink</item>
    <item name="buttonGravity">center_vertical</item>
  </style>

  <style name="MwmWidget.ToolbarStyle.NoElevation">
    <item name="android:elevation">0dp</item>
  </style>

  <style name="MwmWidget.ToolbarTheme" parent="ThemeOverlay.Material3.ActionBar">
    <item name="android:gravity">center_vertical</item>
    <item name="colorAccent">@color/house_ink</item>
    <item name="colorSecondary">@color/house_ink</item>
    <item name="colorControlNormal">@color/house_ink</item>
    <item name="colorOnSurface">@color/house_ink</item>
    <item name="colorOnSurfaceVariant">@color/house_ink</item>
    <item name="android:textColorPrimary">@color/house_ink</item>
    <item name="android:textColorSecondary">@color/house_ink</item>
    <item name="android:textColorHint">@color/house_hint</item>
    <item name="iconTint">@color/house_ink</item>
  </style>

  <style name="MwmWidget.ListView" parent="android:Widget.Material.ListView">
    <item name="android:fadingEdge">none</item>
    <item name="android:divider">@color/divider</item>
    <item name="android:background">@null</item>
    <item name="android:dividerHeight">1px</item>
    <item name="android:animationCache">false</item>
    <item name="android:scrollingCache">false</item>
    <item name="android:cacheColorHint">@android:color/transparent</item>
  </style>

  <style name="MwmWidget.TextView" parent="Widget.MaterialComponents.TextView" />

  <style name="MwmWidget.TextView.Item">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">@dimen/height_item_oneline</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:paddingStart">@dimen/margin_base_plus</item>
    <item name="android:paddingEnd">@dimen/margin_base_plus</item>
    <item name="android:background">?clickableBackground</item>
    <item name="android:drawablePadding">@dimen/margin_base_plus</item>
    <item name="android:textAppearance">@style/MwmTextAppearance.Body1</item>
  </style>

  <style name="MwmWidget.TextView.Search">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">@dimen/search_item_height</item>
    <item name="android:paddingStart">@dimen/margin_base_plus</item>
    <item name="android:paddingEnd">@dimen/margin_base_plus</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:textAppearance">@style/MwmTextAppearance.Body2</item>
    <item name="android:maxLines">1</item>
    <item name="android:background">?clickableBackground</item>
    <item name="android:drawablePadding">@dimen/margin_base_plus</item>
  </style>

  <style name="MwmWidget.TextView.Direction">
    <item name="android:maxLines">3</item>
    <item name="android:textColor">@android:color/white</item>
    <item name="android:textSize">@dimen/text_size_headline</item>
  </style>

  <style name="MwmWidget.TextView.PlanDetail">
    <item name="android:textAppearance">@style/MwmTextAppearance.RoutingDetail</item>
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
  </style>

  <style name="MwmWidget.TextView.PlanDetail.Number">
    <item name="android:textSize">@dimen/text_size_routing_number</item>
    <item name="android:maxLines">1</item>
  </style>

  <style name="MwmWidget.TextView.PlanDetail.Number.Time">
    <item name="android:textStyle">bold</item>
  </style>

  <style name="MwmWidget.TextView.PlanDetail.Number.Secondary">
    <item name="android:textAppearance">@style/MwmTextAppearance.RoutingDetail.Secondary</item>
  </style>

  <style name="MwmWidget.TextView.PlanDetail.Status">
    <item name="android:layout_gravity">center_vertical</item>
    <item name="android:layout_centerVertical">true</item>
  </style>

  <style name="MwmWidget.TextView.NavStreet">
    <item name="android:textAppearance">@style/MwmTextAppearance.NavStreet</item>
  </style>

  <style name="MwmWidget.TextView.NavNextTurn">
    <item name="android:textAppearance">@style/MwmTextAppearance.NavNextTurn</item>
  </style>

  <style name="MwmWidget.TextView.NavNextTurn.Exit">
    <item name="android:textAppearance">@style/MwmTextAppearance.NavNextTurn.Exit</item>
  </style>

  <!-- House rule: no shadows. The rule under a bar is the bar's own (drawable/house_bar). -->
  <style name="MwmWidget.FrameLayout.Elevation"/>

  <style name="MwmWidget.Counter">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minWidth">20dp</item>
    <item name="android:minHeight">20dp</item>
    <item name="android:paddingStart">2dp</item>
    <item name="android:paddingEnd">2dp</item>
    <item name="android:gravity">center</item>
    <item name="android:background">@drawable/counter</item>
    <item name="android:textAppearance">@style/MwmTextAppearance.Body3.Light</item>
    <item name="android:textColor">@color/house_paper</item>
  </style>

  <!-- House rule: the chosen tab is a stone of ink with its label in paper, the others plain
       bold labels, set from the left at their own widths; no indicator slides between them. -->
  <style name="MwmWidget.TabLayout" parent="Widget.Design.TabLayout">
    <item name="android:background">@color/house_paper</item>
    <item name="tabTextAppearance">@style/HouseText.Tab</item>
    <item name="tabMode">scrollable</item>
    <item name="tabGravity">start</item>
    <item name="tabMinWidth">0dp</item>
    <item name="tabContentStart">@dimen/margin_half</item>
    <item name="tabPaddingStart">@dimen/margin_base</item>
    <item name="tabPaddingEnd">@dimen/margin_base</item>
    <item name="tabBackground">@drawable/house_tab</item>
    <item name="tabIndicator">@null</item>
    <item name="tabIndicatorHeight">0dp</item>
    <item name="tabIndicatorAnimationDuration">0</item>
    <item name="tabRippleColor">@null</item>
    <item name="tabUnboundedRipple">false</item>
    <item name="tabTextColor">@color/house_tab_text</item>
    <item name="tabIconTint">@color/house_tab_text</item>
    <item name="tabInlineLabel">true</item>
  </style>

  <style name="MwmWidget.MaterialCalendar.Theme.FullScreen.Dark"
    parent="ThemeOverlay.Material3.MaterialCalendar.Fullscreen">
    <item name="colorSurface">@color/material_calendar_surface_dark</item>
  </style>

  <style name="MwmWidget.MaterialCalendar.Theme.Dark"
    parent="ThemeOverlay.Material3.MaterialCalendar">
    <item name="colorSurface">@color/material_calendar_surface_dark</item>
  </style>

  <style
    name="MwmTheme.BottomSheetDialog"
    parent="@style/ThemeOverlay.Material3.BottomSheetDialog">
    <item name="bottomSheetStyle">@style/MwmWidget.BottomSheetDialog</item>
    <item name="enableEdgeToEdge">true</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowTranslucentNavigation">false</item>
    <!-- House rule: no dimmed backdrop behind a sheet and no slide; it is there or it is not. -->
    <item name="android:backgroundDimEnabled">false</item>
    <item name="android:windowAnimationStyle">@style/HouseAnimation.None</item>
  </style>

  <!-- House rule: a sheet is square paper under a 2dp top edge of ink, with no shadow. The
       edge is the bar that bottom_sheet_handle draws across the top of every sheet. -->
  <style name="MwmWidget.BottomSheetDialog" parent="Widget.Material3.BottomSheet.Modal">
    <item name="backgroundTint">?appBackground</item>
    <item name="elevationOverlayEnabled">false</item>
    <item name="android:elevation">0dp</item>
    <item name="shapeAppearance">@style/HouseShape.Square</item>
    <item name="shapeAppearanceOverlay">@null</item>
  </style>

  <style name="MwmWidget.BottomSheet" parent="MwmWidget.BottomSheetDialog">
    <item name="android:background">@drawable/house_sheet</item>
    <item name="behavior_hideable">false</item>
  </style>

  <style name="MwmWidget.ExtendedFAB" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
    <item name="elevation">0dp</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="android:minHeight">30dp</item>
    <item name="iconPadding">4dp</item>
    <item name="iconSize">20dp</item>
    <item name="iconTint">?accentButtonTextColor</item>
    <item name="android:textColor">?accentButtonTextColor</item>
    <item name="backgroundTint">?colorSecondary</item>
  </style>

  <style name="MwmWidget.M3.Button" parent="Widget.Material3.Button">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">16sp</item>
  </style>

  <style name="MwmWidget.M3.Button.Primary" parent="@style/MwmWidget.M3.Button">
    <item name="backgroundTint">?colorSecondary</item>
  </style>

  <style name="MwmWidget.M3.Button.Secondary" parent="@style/Widget.Material3.Button.OutlinedButton">
    <item name="android:textSize">16sp</item>
    <item name="android:textColor">?colorSecondary</item>
  </style>

  <style name="MwmWidget.M3.FAB.Primary" parent="@style/Widget.Material3.FloatingActionButton.Primary">
    <item name="shapeAppearance">@style/ShapeAppearanceOverlay.Material3.FloatingActionButton</item>
    <item name="backgroundTint">?colorSecondary</item>
    <item name="tint">?android:textColorPrimaryInverse</item>
    <item name="elevation">0dp</item>
    <item name="pressedTranslationZ">0dp</item>
    <item name="hoveredFocusedTranslationZ">0dp</item>
  </style>

  <style name="MwmWidget.M3.FAB.MapButton" parent="@style/Widget.Material3.FloatingActionButton.Primary">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="shapeAppearance">@style/ShapeAppearanceOverlay.Material3.FloatingActionButton</item>
    <item name="backgroundTint">?menuBackground</item>
    <item name="tint">?iconTint</item>
    <item name="fabCustomSize">@dimen/map_button_size</item>
    <item name="maxImageSize">@dimen/map_button_icon_size</item>
    <item name="elevation">0dp</item>
    <item name="pressedTranslationZ">0dp</item>
    <item name="hoveredFocusedTranslationZ">0dp</item>
    <!-- House rule: an edge of ink, not a shadow, stands a button off the map. -->
    <item name="android:foreground">@drawable/house_edge_fab</item>
  </style>

  <style name="MwmWidget.M3.FAB.MapButton.Square">
    <item name="backgroundTint">?menuBackground</item>
  </style>

  <style name="MwmWidget.M3.FAB.MapButton.Zoom">
    <item name="maxImageSize">34dp</item>
  </style>

  <style name="MwmWidget.M3.FAB.MapButton.Bottom">
    <!-- This one styles the row that holds the buttons, which takes no edge of its own. -->
    <item name="android:foreground">@null</item>
    <item name="android:maxWidth">@dimen/map_buttons_bottom_max_width</item>
    <item name="android:padding">@dimen/nav_frame_padding</item>
  </style>

  <style name="ShapeAppearance.MapButton.Zoom.Plus" parent="">
    <item name="cornerSizeTopLeft">10%</item>
    <item name="cornerSizeTopRight">10%</item>
    <item name="cornerSizeBottomRight">50%</item>
    <item name="cornerSizeBottomLeft">50%</item>
  </style>

  <style name="ShapeAppearance.MapButton.Zoom.Minus" parent="">
    <item name="cornerSizeBottomLeft">10%</item>
    <item name="cornerSizeBottomRight">10%</item>
    <item name="cornerSizeTopLeft">50%</item>
    <item name="cornerSizeTopRight">50%</item>
  </style>

  <style name="ShapeAppearance.MapButton.RoutePreview.Previous" parent="">
    <item name="cornerSizeTopLeft">50%</item>
    <item name="cornerSizeTopRight">10%</item>
    <item name="cornerSizeBottomRight">10%</item>
    <item name="cornerSizeBottomLeft">50%</item>
  </style>

  <style name="ShapeAppearance.MapButton.RoutePreview.Text" parent="">
    <item name="cornerSizeTopLeft">10%</item>
    <item name="cornerSizeTopRight">10%</item>
    <item name="cornerSizeBottomRight">10%</item>
    <item name="cornerSizeBottomLeft">10%</item>
    <item name="android:layout_width">96dp</item>
  </style>

  <style name="ShapeAppearance.MapButton.RoutePreview.Next" parent="">
    <item name="cornerSizeBottomLeft">10%</item>
    <item name="cornerSizeBottomRight">50%</item>
    <item name="cornerSizeTopLeft">10%</item>
    <item name="cornerSizeTopRight">50%</item>
  </style>
</resources>
