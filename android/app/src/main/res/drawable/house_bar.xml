<?xml version="1.0" encoding="utf-8"?>
<!-- A top bar: paper, with a thin rule of ink beneath (house rule). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/house_ink"/>
    </shape>
  </item>
  <item android:bottom="@dimen/house_rule">
    <shape android:shape="rectangle">
      <solid android:color="@color/house_paper"/>
    </shape>
  </item>
</layer-list>
