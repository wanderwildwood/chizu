/* In ink, as the default style is: greys only, a white ground, dark features and labels.
 * A name the default style has too takes its value from there. The exceptions follow from this
 * style drawing its roads without an edge until zoom 14 or 15, and the small roads without one at
 * any zoom: a white road would not show on the white ground, so the roads are grey lines, darker
 * the bigger the road, with a black edge (casing_road) once they are wide. The areas roads run
 * through (parks, airfields) are kept lighter than those roads for the same reason.
 */

/* BASE */

@background: #FFFFFF;

/* BOUNDARIES */
@border_country: #535353;
/* @border_country_light: #535353; */
@border_region: #444444;


/* ROADS */

/* trunk0 is every motorway and trunk; trunk1 only the far-out roads of the world map. */
@trunk0: #666666;
@trunk1: #666666;
@primary0:  #777777;
@primary1: #888888;
@primary2: #DDDDDD;
@secondary0: #999999;
@residential: #AAAAAA;
@unclassified: #AAAAAA;
@pedestrian: #777777;
@footway: #777777;
@cycleway: #555555;
@construction: #999999;
@track: #444444;
@path: #4D4D4D;
@bridleway: #1A1A1A;


/* bridges */
@bridge_background: #FFFFFF;
@bridge_casing: #000000;
@casing_road:  #000000;

/* tunnels */

@primary_tunnel: #E9E9E9;
@trunk_tunnel: #D8D8D8;
@primary_tunnel_casing: #7A7A7A;
@trunk_tunnel_casing: #7A7A7A;
@secondary_tunnel: #F2F2F2;
@secondary_tunnel_casing:  #7A7A7A;
@tertiary_tunnel: #FFFFFF;
@tertiary_tunnel_casing:  #7A7A7A;
@unclassified_tunnel: #FFFFFF;
@unclassified_tunnel_casing: #7A7A7A;

/* TRANSPORT */
@railway_light: #666666;
@railway: #444444;
@railway_tourism: #444444;
@railway_dash: #FFFFFF;
@railway_tunnel: #7A7A7A;
/* @aerialway: #2B2B2B; */
@tram: #444444;
/* @ferry: #555555; */

/*aerodrome*/
