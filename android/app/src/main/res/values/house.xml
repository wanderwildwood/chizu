<?xml version="1.0" encoding="utf-8"?>
<!-- The house style, at theme level. It sits in its own files so the upstream themes and styles
     keep their shape: MwmTheme takes HouseTheme as its parent, and everything here overrides
     what MwmTheme.Base set. Written for a 4.3" E Ink panel with sixteen greys: black on white,
     hard edges, Lato from 16sp up, nothing that moves and nothing that casts a shadow. -->
<resources xmlns:tools="http://schemas.android.com/tools">
  <color name="house_ink">#FF000000</color>
  <color name="house_paper">#FFFFFFFF</color>
  <!-- Hint and placeholder text: grey enough to read as a hint, dark enough to read. -->
  <color name="house_hint">#FF666666</color>
  <bool name="house_light_bars">true</bool>

  <dimen name="house_rule">1dp</dimen>
  <dimen name="house_edge">2dp</dimen>
  <dimen name="house_dialog_corner">12dp</dimen>
  <!-- Wider than any screen this runs on, so a dialog is always the full width inside its margins. -->
  <item name="house_dialog_min_width" type="dimen">100%</item>

  <style name="HouseTheme" parent="MwmTheme.Base">
    <!-- Type: Lato everywhere, on a scale of 28 / 24 / 20 / 18 / 16 with 16sp as the floor. -->
    <item name="android:fontFamily">@font/lato</item>
    <item name="fontFamily">@font/lato</item>
    <item name="textAppearanceDisplayLarge">@style/HouseText.DisplayLarge</item>
    <item name="textAppearanceDisplayMedium">@style/HouseText.DisplayMedium</item>
    <item name="textAppearanceDisplaySmall">@style/HouseText.DisplaySmall</item>
    <item name="textAppearanceHeadlineLarge">@style/HouseText.HeadlineLarge</item>
    <item name="textAppearanceHeadlineMedium">@style/HouseText.HeadlineMedium</item>
    <item name="textAppearanceHeadlineSmall">@style/HouseText.HeadlineSmall</item>
    <item name="textAppearanceTitleLarge">@style/HouseText.TitleLarge</item>
    <item name="textAppearanceTitleMedium">@style/HouseText.TitleMedium</item>
    <item name="textAppearanceTitleSmall">@style/HouseText.TitleSmall</item>
    <item name="textAppearanceBodyLarge">@style/HouseText.BodyLarge</item>
    <item name="textAppearanceBodyMedium">@style/HouseText.BodyMedium</item>
    <item name="textAppearanceBodySmall">@style/HouseText.BodySmall</item>
    <item name="textAppearanceLabelLarge">@style/HouseText.LabelLarge</item>
    <item name="textAppearanceLabelMedium">@style/HouseText.LabelMedium</item>
    <item name="textAppearanceLabelSmall">@style/HouseText.LabelSmall</item>
    <item name="android:textAppearanceListItem">@style/MwmTextAppearance.Body1</item>
    <item name="android:textAppearanceListItemSmall">@style/MwmTextAppearance.Body1</item>
    <item name="android:textAppearanceListItemSecondary">@style/MwmTextAppearance.Body3</item>
    <item name="textAppearanceListItem">@style/MwmTextAppearance.Body1</item>
    <item name="textAppearanceListItemSmall">@style/MwmTextAppearance.Body1</item>
    <item name="textAppearanceListItemSecondary">@style/MwmTextAppearance.Body3</item>
    <item name="android:textAppearanceLargePopupMenu">@style/MwmTextAppearance.Body1</item>
    <item name="android:textAppearanceSmallPopupMenu">@style/MwmTextAppearance.Body1</item>
    <item name="textAppearanceLargePopupMenu">@style/MwmTextAppearance.Body1</item>
    <item name="textAppearanceSmallPopupMenu">@style/MwmTextAppearance.Body1</item>

    <!-- One ink. A second line is set apart by its size, not by a grey the panel washes out. -->
    <item name="android:textColorTertiary">@color/house_ink</item>
    <item name="android:textColorHint">@color/house_hint</item>
    <item name="iconTint">@color/house_ink</item>
    <item name="colorPrimary">@color/md_theme_primary</item>
    <item name="colorOutline">@color/house_ink</item>
    <item name="colorOnSurfaceVariant">@color/house_ink</item>
    <item name="colorLogo">@color/house_ink</item>
    <item name="drivingOptionsViewBg">@color/house_paper</item>
    <item name="dividerColor">@color/house_ink</item>

    <!-- Bars: paper with ink on it, a thin rule beneath, and a status bar to match. -->
    <item name="toolbarStyle">@style/MwmWidget.ToolbarStyle</item>
    <item name="appBarLayoutStyle">@style/HouseWidget.AppBarLayout</item>
    <item name="tabStyle">@style/MwmWidget.TabLayout</item>
    <item name="android:statusBarColor">@color/house_paper</item>
    <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/house_light_bars</item>
    <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/house_light_bars</item>

    <!-- Nothing ripples, nothing slides, nothing casts a shadow. -->
    <item name="colorControlHighlight">@android:color/transparent</item>
    <item name="colorBtnHighlight">@android:color/transparent</item>
    <item name="android:colorControlHighlight">@android:color/transparent</item>
    <item name="android:windowAnimationStyle">@style/HouseAnimation.None</item>
    <item name="materialCardViewStyle">@style/HouseWidget.Card</item>
    <item name="materialCardViewElevatedStyle">@style/HouseWidget.Card</item>
    <item name="materialCardViewOutlinedStyle">@style/HouseWidget.Card</item>
    <item name="materialCardViewFilledStyle">@style/HouseWidget.Card</item>
    <item name="android:popupMenuStyle">@style/HouseWidget.PopupMenu</item>
    <item name="popupMenuStyle">@style/HouseWidget.PopupMenu</item>
    <item name="actionOverflowMenuStyle">@style/HouseWidget.PopupMenu.Overflow</item>
    <item name="listPopupWindowStyle">@style/HouseWidget.PopupMenu.ListPopupWindow</item>

    <!-- Dialogs that are not Material alert dialogs (DialogFragment windows). -->
    <item name="android:dialogTheme">@style/HouseTheme.Dialog</item>
    <item name="dialogTheme">@style/HouseTheme.Dialog</item>

    <!-- Settings: rows parted by space, no lines. -->
    <item name="preferenceTheme">@style/HousePreferenceTheme</item>
  </style>

  <!-- A plain dialog window: paper in a rim of ink, the screen behind it left as it is. -->
  <style name="HouseTheme.Dialog" parent="ThemeOverlay.Material3.Dialog">
    <item name="android:windowBackground">@drawable/house_dialog_window</item>
    <item name="android:backgroundDimEnabled">false</item>
    <item name="android:windowAnimationStyle">@style/HouseAnimation.None</item>
    <item name="android:windowElevation">0dp</item>
  </style>

  <!-- The Material alert dialog's frame: its window draws paper with the house corner, and the
       layout draws the rim (the library's own background takes no stroke). -->
  <style name="HouseWidget.AlertDialog" parent="MaterialAlertDialog.Material3">
    <item name="backgroundTint">@color/house_paper</item>
    <item name="android:layout">@layout/house_alert_dialog</item>
    <item name="shapeAppearance">@style/HouseShape.Dialog</item>
    <item name="shapeAppearanceOverlay">@null</item>
    <item name="backgroundInsetStart">16dp</item>
    <item name="backgroundInsetEnd">16dp</item>
  </style>

  <style name="HouseWidget.AlertDialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
    <item name="android:textAppearance">@style/HouseText.TitleMedium</item>
    <item name="android:textColor">@color/house_ink</item>
    <item name="android:textStyle">bold</item>
  </style>

  <style name="HouseWidget.AlertDialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
    <item name="android:textAppearance">@style/HouseText.BodyMedium</item>
    <item name="android:textColor">@color/house_ink</item>
  </style>

  <style name="HouseShape.Dialog" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">@dimen/house_dialog_corner</item>
  </style>

  <style name="HouseShape.Square" parent="">
    <item name="cornerFamily">cut</item>
    <item name="cornerSize">0dp</item>
  </style>

  <style name="HouseShape.Stone" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">4dp</item>
  </style>

  <style name="HouseWidget" />

  <style name="HouseWidget.AppBarLayout" parent="Widget.Material3.AppBarLayout">
    <item name="android:background">@color/house_paper</item>
    <item name="elevation">0dp</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="liftOnScroll">false</item>
  </style>

  <!-- Cards keep their edge with a line of ink, not a tint or a shadow. -->
  <style name="HouseWidget.Card" parent="Widget.Material3.CardView.Outlined">
    <item name="cardBackgroundColor">@color/house_paper</item>
    <item name="strokeColor">@color/house_ink</item>
    <item name="strokeWidth">1dp</item>
    <item name="cardElevation">0dp</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="rippleColor">@android:color/transparent</item>
  </style>

  <!-- A dialog drawn as a card in a clear window: the same rim and corner as any dialog. -->
  <style name="HouseWidget.DialogCard" parent="Widget.Material3.CardView.Outlined">
    <item name="cardBackgroundColor">@color/house_paper</item>
    <item name="strokeColor">@color/house_ink</item>
    <item name="strokeWidth">@dimen/house_edge</item>
    <item name="cardCornerRadius">@dimen/house_dialog_corner</item>
    <item name="cardElevation">0dp</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="rippleColor">@android:color/transparent</item>
  </style>

  <style name="HouseWidget.PopupMenu" parent="Widget.Material3.PopupMenu">
    <item name="android:popupBackground">@drawable/house_outline</item>
    <item name="android:popupElevation">0dp</item>
  </style>

  <style name="HouseWidget.PopupMenu.Overflow" parent="Widget.Material3.PopupMenu.Overflow">
    <item name="android:popupBackground">@drawable/house_outline</item>
    <item name="android:popupElevation">0dp</item>
  </style>

  <style name="HouseWidget.PopupMenu.ListPopupWindow" parent="Widget.Material3.PopupMenu.ListPopupWindow">
    <item name="android:popupBackground">@drawable/house_outline</item>
    <item name="android:popupElevation">0dp</item>
  </style>

  <!-- No window transitions: a slide between screens is a string of half-drawn frames here. -->
  <style name="HouseAnimation" />

  <style name="HouseAnimation.None" parent="@android:style/Animation">
    <item name="android:windowEnterAnimation">@null</item>
    <item name="android:windowExitAnimation">@null</item>
    <item name="android:windowShowAnimation">@null</item>
    <item name="android:windowHideAnimation">@null</item>
    <item name="android:activityOpenEnterAnimation">@null</item>
    <item name="android:activityOpenExitAnimation">@null</item>
    <item name="android:activityCloseEnterAnimation">@null</item>
    <item name="android:activityCloseExitAnimation">@null</item>
    <item name="android:taskOpenEnterAnimation">@null</item>
    <item name="android:taskOpenExitAnimation">@null</item>
    <item name="android:taskCloseEnterAnimation">@null</item>
    <item name="android:taskCloseExitAnimation">@null</item>
    <item name="android:taskToFrontEnterAnimation">@null</item>
    <item name="android:taskToFrontExitAnimation">@null</item>
    <item name="android:taskToBackEnterAnimation">@null</item>
    <item name="android:taskToBackExitAnimation">@null</item>
  </style>

  <style name="HousePreferenceTheme" parent="PreferenceThemeOverlay">
    <item name="preferenceFragmentCompatStyle">@style/HousePreferenceFragment</item>
    <item name="preferenceFragmentListStyle">@style/HousePreferenceFragmentList</item>
  </style>

  <style name="HousePreferenceFragment" parent="PreferenceFragment.Material">
    <item name="android:divider">@null</item>
    <item name="android:dividerHeight">0dp</item>
    <item name="allowDividerAfterLastItem">false</item>
  </style>

  <style name="HousePreferenceFragmentList" parent="PreferenceFragmentList.Material">
    <item name="android:scrollbars">none</item>
  </style>

  <!-- The Material 3 type roles, in Lato on the house scale. -->
  <style name="HouseText" />

  <style name="HouseText.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
  </style>

  <style name="HouseText.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
  </style>

  <style name="HouseText.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
  </style>

  <style name="HouseText.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
    <item name="android:textSize">28sp</item>
  </style>

  <style name="HouseText.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
    <item name="android:textSize">28sp</item>
  </style>

  <style name="HouseText.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
    <item name="android:textSize">24sp</item>
  </style>

  <style name="HouseText.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
    <item name="android:textSize">24sp</item>
  </style>

  <style name="HouseText.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
    <item name="android:textSize">20sp</item>
  </style>

  <style name="HouseText.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
    <item name="android:textSize">16sp</item>
  </style>

  <style name="HouseText.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
    <item name="android:textSize">18sp</item>
  </style>

  <style name="HouseText.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
    <item name="android:textSize">18sp</item>
  </style>

  <style name="HouseText.BodySmall" parent="TextAppearance.Material3.BodySmall">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
    <item name="android:textSize">16sp</item>
  </style>

  <style name="HouseText.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
    <item name="android:textSize">18sp</item>
  </style>

  <style name="HouseText.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
    <item name="android:textSize">16sp</item>
  </style>

  <style name="HouseText.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
    <item name="fontFamily">@font/lato</item>
    <item name="android:fontFamily">@font/lato</item>
    <item name="android:textSize">16sp</item>
  </style>

  <!-- A tab label: bold, as every tab is; the chosen one is told by its stone. -->
  <style name="HouseText.Tab" parent="HouseText.TitleSmall">
    <item name="android:textStyle">bold</item>
    <item name="textAllCaps">false</item>
    <item name="android:textAllCaps">false</item>
  </style>
  <!-- The info icon in the Settings top bar. -->
  <item name="about" type="id"/>
</resources>
