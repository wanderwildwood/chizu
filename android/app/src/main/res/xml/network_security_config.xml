<?xml version="1.0" encoding="utf-8"?>
<!--
    Atlas: cleartext http stays permitted, for servers a person types in themselves: a map
    server of one's own (Settings, map downloads), a route server of one's own, and a tile
    server of one's own for the streamed map. On a home network these often speak plain http,
    there being no certificate to be had for an address like 192.168.1.10, and Android cannot
    scope cleartext to a range of addresses, so it is permitted app-wide. Every server the app
    knows by itself (the map servers and their list, the streamed tiles, the route and address
    servers) is https because it asks for https; the map list (countries.txt) is also checked
    against a signature built into the app.

    Only the system's certificates are trusted. CoMaps also trusted certificates the person
    added to the phone, and carried six root certificates for Android 7, which this app does not
    run on (Android 11 is the least); neither is needed here.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
