<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <!-- Atlas: mph or km/h, two choices side by side. Not persisted here: the value lives in the map core. -->
  <com.wanderwildwood.chizu.ui.UnitsChoicePreference
    android:key="@string/pref_munits_miles"
    android:persistent="false" />

  <PreferenceScreen
      android:key="@string/prefs_routing"
      android:title="@string/routing_options_title"
      app:icon="@drawable/ic_instant_mix">
    <intent
        android:targetClass="app.organicmaps.settings.RoutingOptionsActivity"
        android:targetPackage="@string/app_id">
      <extra android:name="from" android:value="settings" />
    </intent>
  </PreferenceScreen>

  <!-- Atlas: routes from a route server. Not persisted here: OnlineRoutes keeps both values. -->
  <SwitchPreferenceCompat
    android:key="@string/pref_online_routes"
    android:persistent="false"
    android:summary="@string/online_routes_switch_summary"
    android:title="@string/online_routes_switch"
    android:widgetLayout="@layout/preference_switch"
    app:singleLineTitle="false" />
  <EditTextPreference
    android:dialogMessage="@string/online_routes_server_message"
    android:key="@string/pref_online_route_server"
    android:persistent="false"
    android:title="@string/online_routes_server"
    app:singleLineTitle="false" />
  <!-- Atlas: an address looked up online. Not persisted here: OnlineAddress keeps both values. -->
  <SwitchPreferenceCompat
    android:key="@string/pref_online_address"
    android:persistent="false"
    android:summary="@string/online_address_switch_summary"
    android:title="@string/online_address_switch"
    android:widgetLayout="@layout/preference_switch"
    app:singleLineTitle="false" />
  <EditTextPreference
    android:dialogMessage="@string/online_address_server_message"
    android:key="@string/pref_online_address_server"
    android:persistent="false"
    android:title="@string/online_address_server"
    app:singleLineTitle="false" />
  <!-- Atlas: the streamed map. Not persisted here: StreamedMap keeps both values. -->
  <SwitchPreferenceCompat
    android:key="@string/pref_streamed_map"
    android:persistent="false"
    android:summary="@string/streamed_map_switch_summary"
    android:title="@string/streamed_map_switch"
    android:widgetLayout="@layout/preference_switch"
    app:singleLineTitle="false" />
  <SwitchPreferenceCompat
    android:key="@string/pref_streamed_map_wifi"
    android:persistent="false"
    android:summary="@string/streamed_map_wifi_summary"
    android:title="@string/streamed_map_wifi"
    android:widgetLayout="@layout/preference_switch"
    app:singleLineTitle="false" />
  <EditTextPreference
    android:dialogMessage="@string/streamed_map_server_message"
    android:key="@string/pref_streamed_map_server"
    android:persistent="false"
    android:title="@string/streamed_map_server"
    app:singleLineTitle="false" />

  <SwitchPreferenceCompat
    android:key="@string/pref_3d"
    android:title="@string/pref_map_3d_title"
    android:widgetLayout="@layout/preference_switch"
    app:icon="@drawable/ic_three_d_rotation"
    app:singleLineTitle="false" />
  <SwitchPreferenceCompat
    android:key="@string/pref_auto_zoom"
    android:title="@string/pref_map_auto_zoom"
    android:widgetLayout="@layout/preference_switch"
    app:singleLineTitle="false" />
  <SwitchPreferenceCompat
    android:defaultValue="true"
    android:key="@string/pref_speedlimit"
    android:title="@string/pref_speedlimit_title"
    android:widgetLayout="@layout/preference_switch"
    app:icon="@drawable/ic_speed"
    app:singleLineTitle="true" />
  <ListPreference
    android:key="@string/pref_tts_speed_cameras"
    android:title="@string/speedcams_alert_title"
    app:singleLineTitle="false"
    android:entries="@array/speed_cameras"
    android:entryValues="@array/speed_cameras_values"
    android:defaultValue="@string/auto_enum_value" />
  <Preference
    android:enabled="true"
    android:key="@string/pref_tts_speed_cameras_info"
    android:persistent="false"
    android:selectable="false"
    android:summary="@string/prefs_speed_cameras_information" />
  <Preference
    android:key="@string/pref_android_auto_support"
    android:persistent="false"
    app:isPreferenceVisible="false"
    android:title="@string/pref_aa_support_title" />
  <SwitchPreferenceCompat
    android:defaultValue="true"
    android:key="@string/pref_enable_auto_reroute"
    android:title="@string/pref_enable_auto_reroute_title"
    android:summary="@string/pref_enable_auto_reroute_description"
    android:widgetLayout="@layout/preference_switch"
    app:singleLineTitle="false" />

</androidx.preference.PreferenceScreen>
