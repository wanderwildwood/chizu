<?xml version="1.0" encoding="utf-8"?>
<!-- Atlas: one of the turns after the next one on the guidance card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="44dp"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="@dimen/margin_base"
  android:paddingEnd="@dimen/margin_base">

  <ImageView
    android:id="@+id/then_turn"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:importantForAccessibility="no"
    android:scaleType="fitCenter"
    app:tint="@color/house_ink"
    tools:src="@drawable/ic_card_left" />

  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/then_distance"
    android:textStyle="bold"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_half"
    android:fontFamily="@font/lato_bold"
    android:maxLines="1"
    android:minWidth="76dp"
    android:textColor="@color/house_ink"
    android:textSize="18sp"
    tools:text="1.2 mi" />

  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/then_street"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_half"
    android:layout_weight="1"
    android:ellipsize="end"
    android:lineSpacingMultiplier="0.85"
    android:maxLines="2"
    android:textColor="@color/house_ink"
    android:textSize="18sp"
    tools:text="Forest Avenue" />
</LinearLayout>
