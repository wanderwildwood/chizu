<?xml version="1.0" encoding="utf-8"?>
<!-- Atlas: the guidance card. While a route is followed this covers the map: the next turn in
     large type, the two turns after it, the speeds, and a button that shows the map. An E Ink
     panel cannot keep up with a map that moves, so the map is asked for, not shown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/nav_card"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/house_paper"
  android:clickable="true"
  android:focusable="true"
  android:orientation="vertical"
  tools:showIn="@layout/layout_nav">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_base"
    android:paddingEnd="@dimen/margin_base"
    android:paddingTop="@dimen/margin_half">

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">
      <ImageView
        android:id="@+id/card_turn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        app:tint="@color/house_ink"
        tools:src="@drawable/ic_turn_right" />
      <com.google.android.material.textview.MaterialTextView
        android:id="@+id/card_exit"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/lato_bold"
        android:textColor="@color/house_ink"
        android:textSize="28sp"
        android:visibility="gone"
        tools:text="3" />
    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/card_distance"
      android:textStyle="bold"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="@font/lato_bold"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:textColor="@color/house_ink"
      android:textSize="56sp"
      tools:text="0.4 mi" />

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/card_street"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/margin_half"
      android:ellipsize="end"
      android:gravity="center"
      android:maxLines="2"
      android:textColor="@color/house_ink"
      android:textSize="24sp"
      tools:text="East 20th Street" />
  </LinearLayout>

  <app.organicmaps.widget.LanesView
    android:id="@+id/card_lanes"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginStart="@dimen/margin_base"
    android:layout_marginEnd="@dimen/margin_base"
    android:layout_marginBottom="@dimen/margin_half"
    android:padding="@dimen/margin_quarter"
    android:visibility="gone"
    app:lanesActiveLaneTintColor="?navLaneArrowActiveColor"
    app:lanesBackgroundColor="?navLanesBackgroundColor"
    app:lanesCornerRadius="@dimen/margin_half"
    app:lanesEditModeLanesCount="4"
    app:lanesInactiveLaneTintColor="?navLaneArrowInactiveColor" />

  <View
    android:id="@+id/card_then_rule"
    android:layout_width="match_parent"
    android:layout_height="@dimen/house_rule"
    android:background="@color/house_ink" />

  <include
    android:id="@+id/card_then_1"
    layout="@layout/item_nav_card_then" />

  <include
    android:id="@+id/card_then_2"
    layout="@layout/item_nav_card_then" />

  <View
    android:layout_width="match_parent"
    android:layout_height="@dimen/house_rule"
    android:background="@color/house_ink" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/margin_base"
    android:paddingEnd="@dimen/margin_base">

    <app.organicmaps.widget.SpeedLimitView
      android:id="@+id/card_speed_limit"
      style="@style/MwmWidget.SpeedLimit"
      android:layout_width="52dp"
      android:layout_height="52dp"
      android:layout_marginEnd="@dimen/margin_half" />

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/card_speed"
      android:textStyle="bold"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:fontFamily="@font/lato_bold"
      android:maxLines="1"
      android:textColor="@color/house_ink"
      android:textSize="24sp"
      tools:text="45 mph" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/card_map"
      style="@style/MwmWidget.M3.Button.Primary"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:text="@string/guidance_map"
      android:textSize="18sp" />
  </LinearLayout>
</LinearLayout>
